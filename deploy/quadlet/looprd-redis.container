[Unit]
Description=Optional Looprd Redis event fanout companion

[Container]
Image=docker.io/library/redis:7.4-alpine
ContainerName=looprd-redis
Network=looprd-events.network
UserNS=keep-id:uid=999,gid=999
User=999:999
Volume=%h/.config/looprd/secrets/redis.acl:/etc/redis/users.acl:ro,Z
Exec=redis-server --bind 0.0.0.0 --protected-mode yes --aclfile /etc/redis/users.acl --save "" --appendonly no --maxmemory 128mb --maxmemory-policy noeviction
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,size=16m
# No PublishPort: only explicitly attached runtimes can reach Redis.

[Service]
Restart=on-failure
RestartSec=5
MemoryMax=192M
TimeoutStartSec=300

[Install]
WantedBy=default.target
