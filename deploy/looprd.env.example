LOOPRD_SOURCES=/etc/looprd/sources.yaml
LOOPRD_DATA=/var/lib/looprd
LOOPRD_SECRETS=/etc/looprd/secrets
LOOPRD_POLL_SECONDS=60
LOOPRD_DRAIN_SECONDS=30
# Shared Redis deployments must use distinct namespaces unless fanout is intentional.
LOOPRD_EVENT_NAMESPACE=looprd
# Optional host-side sampler; see docs/container-metrics.md before enabling.
# LOOPRD_CONTAINER_METRICS_FILE=/etc/looprd/metrics/containers.json
LOOPRD_ALLOW_PYTHON=false
# Print a management key once at first start if no mounted admin-token exists.
LOOPRD_BOOTSTRAP_ADMIN=true
# Comma-separated browser origins, required for browser WebSocket connections.
LOOPRD_ORIGINS=https://your-ui.example.net
# Components may also declare cors.allowedOrigins in looprd.yaml.
# Optional ceiling on component origins (unset = unrestricted; empty = deny all).
# LOOPRD_ORIGIN_RESTRICTIONS=https://your-ui.example.net,http://tauri.localhost
# Private sources and referenced specs (choose the real private configuration repo).
# LOOPRD_SOURCES=github://pac-labs/YOUR-PRIVATE-CONFIG/sources.yaml?ref=main
# Mounted secret file; do not put its value here. The file is reread for token rotation.
# LOOPRD_GITHUB_TOKEN_FILE=/etc/looprd/secrets/github-token
# Optional UnifiedPush/ntfy provider. Public origin must be HTTPS. Delivery may
# use the trusted internal companion origin. Neither URL belongs in looprd.yaml.
# LOOPRD_PUSH_PUBLIC_URL=https://push.example.com
# LOOPRD_PUSH_DELIVERY_URL=http://looprd-ntfy:8080
# LOOPRD_PUSH_TOKEN_SECRET=push/publish-token

# Optional observation only, no automatic Atrium submission.
# LOOPRD_DISCOVERY_ENABLED=false
# LOOPRD_DISCOVERY_COMPONENTS=demo
# LOOPRD_DISCOVERY_HTTPS_ORIGINS=https://metadata.example.com
# Generic advertised deployment metadata; align with the existing reverse proxy.
# LOOPRD_DEPLOYMENT_ID=example-node
# LOOPRD_PUBLIC_URL=https://api.example.com
# Opt-in only after a matching Atrium v2 receiver is installed and bound.
# LOOPRD_DISCOVERY_DELIVERY=false
# LOOPRD_DISCOVERY_RECEIVER=https://catalog.example.com/looprd/atrium/v1/registry/discovery/v2
# LOOPRD_DISCOVERY_CREDENTIAL=atrium/discovery-token
# Generic, optional read-only consumer connections: service IDs -> secret REFERENCES.
# LOOPRD_REGISTRATION_READERS={"atrium":"registration-readers/atrium"}
